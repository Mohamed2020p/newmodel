Options -Indexes

# Never serve databases or logs
<FilesMatch "\.(db|sqlite|sqlite3|log|md)$">
  Require all denied
</FilesMatch>

# The data/ folder has its own deny-all .htaccess (created automatically),
# but block it here too, just in case:
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [F,L]
</IfModule>
