Options -Indexes

# The app POSTs to /connect (no extension) — route it to connect.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^connect/?$ connect.php [L,QSA]
  RewriteRule ^data/ - [F,L]
</IfModule>

# Never serve key/log/txt data files from the web
<FilesMatch "\.(db|sqlite|sqlite3|log|md|txt)$">
  Require all denied
</FilesMatch>
