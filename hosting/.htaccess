RewriteEngine On
RewriteBase /

# pretty endpoint: /connect -> connect.php (the app uses /k.php which needs no rewrite)
RewriteRule ^connect/?$ connect.php [L,QSA]

# block direct access to data files (keys, logs)
<FilesMatch "\.(db|sqlite|sqlite3|log|md|txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# block listing the data folder (index.html inside data/ also covers this)
RewriteRule ^data/ - [F,L]
