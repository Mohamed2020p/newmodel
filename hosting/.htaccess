Options -Indexes

# Never serve key/log/txt data files from the web
<FilesMatch "\.(db|sqlite|sqlite3|log|md|txt)$">
  Require all denied
</FilesMatch>

# data/ has its own deny-all .htaccess too (created automatically)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [F,L]
</IfModule>
